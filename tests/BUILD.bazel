"""Tests for rules_kubectl.

- Analysis tests verify the rules instantiate cleanly without invoking
  kubectl.
- Smoke test composes a real kind cluster with the rule under test
  applying tests/manifest.yaml (a Namespace + a Deployment), then
  asserts the Deployment lands and reaches Available. Needs Docker
  on the host.
"""

load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_kubectl//:defs.bzl", "kubectl_apply", "kubectl_apply_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":analysis_tests.bzl", "kubectl_apply_health_check_test_suite", "kubectl_apply_test_suite")

# ---- analysis ---------------------------------------------------------------

kubectl_apply_test_suite(name = "kubectl_apply_analysis")

kubectl_apply_health_check_test_suite(name = "kubectl_apply_health_check_analysis")

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.35")

kind_health_check(name = "cluster_health", cluster = ":cluster")

itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

# Rule under test — applies tests/manifest.yaml, waits for the Deployment
# to be Available, idles.
kubectl_apply(
    name = "apply_bin",
    manifests = ["manifest.yaml"],
    namespace = "smoke",
    wait_for_deployments = ["hello"],
    tags = ["manual"],
)

kubectl_apply_health_check(
    name = "apply_health_bin",
    namespace = "smoke",
    wait_for_deployments = ["hello"],
    tags = ["manual"],
)

# Wrappers source the kind cluster's env file so KUBECONFIG/KUBECTL cross
# the `exec` boundary into the rule binary. Same pattern every operator
# rule uses.
sh_binary(
    name = "apply_wrapper",
    srcs = ["apply_wrapper.sh"],
    data = [":apply_bin"],
)

sh_binary(
    name = "apply_health_wrapper",
    srcs = ["apply_health_wrapper.sh"],
    data = [":apply_health_bin"],
)

itest_service(
    name = "apply_svc",
    exe = ":apply_wrapper",
    deps = [":kind_svc"],
    health_check = ":apply_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":apply_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",  # needs Docker
        "no-sandbox",
        "requires-network",
    ],
)
