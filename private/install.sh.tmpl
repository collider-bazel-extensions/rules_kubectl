#!/usr/bin/env bash
# Generated wrapper for kubectl_apply.
set -euo pipefail

if [[ -z "${RUNFILES_DIR:-}" ]]; then
  if [[ -d "${0}.runfiles" ]]; then RUNFILES_DIR="${0}.runfiles"
  elif [[ -d "$(dirname "$0").runfiles" ]]; then RUNFILES_DIR="$(dirname "$0").runfiles"
  fi
  export RUNFILES_DIR
fi

exec "${RUNFILES_DIR}/_main/{LAUNCHER}" \
  --mode install \
  --kubeconfig-env "{KUBECONFIG_ENV}" \
  --namespace "{NAMESPACE}" \
  {APPLY_NS_FLAG} \
  {CREATE_NS_FLAG} \
  {SERVER_SIDE_FLAG} \
  --wait-timeout "{WAIT_TIMEOUT}" \
  --retry-attempts "{RETRY_ATTEMPTS}" \
  {MANIFEST_FLAGS} \
  {WAIT_DEPLOY_FLAGS} \
  {WAIT_ROLLOUT_FLAGS} \
  {WAIT_CRD_FLAGS}
